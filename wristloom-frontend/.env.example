# Database (Supabase PostgreSQL Connection Pooling & Direct)
DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:5432/postgres"

# NextAuth
AUTH_SECRET="your-32-byte-base64-secret"
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Supabase Realtime & Storage
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Google Maps API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-google-maps-browser-key"
GOOGLE_MAPS_SERVER_API_KEY="your-google-maps-server-key"

# Razorpay Payments
RAZORPAY_KEY_ID="rzp_test_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_your_key_id"

# Resend Email
RESEND_API_KEY="re_your_resend_api_key"
EMAIL_FROM="Wristloom <concierge@wristloom.com>"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
